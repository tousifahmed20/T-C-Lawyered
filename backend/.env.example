# Copy to .env and fill in. Railway injects DATABASE_URL automatically in prod.

# Postgres connection. Local (Docker, see docker-compose.yml):
#   postgresql://tclawyered:tclawyered@localhost:5432/tclawyered
DATABASE_URL=postgresql://tclawyered:tclawyered@localhost:5432/tclawyered

PORT=3000

# Max POST /policy per IP per rolling 24h (in-memory; resets on restart).
RATE_LIMIT_WRITES=100

# Server-side authenticity gate: uploads rejected below this confidence.
AUTHENTICITY_MIN_CONFIDENCE=85

# CORS. Comma-separated. Reads can be public; writes come from the extension.
# Use "*" to allow all origins (fine for a public read cache).
ALLOWED_ORIGINS=chrome-extension://*

# Keep-warm self-ping schedule (cron). Every 10 min keeps the free tier awake.
KEEPWARM_CRON=*/10 * * * *

# Optional: set to "true" to disable the keep-warm cron (e.g. local dev).
DISABLE_KEEPWARM=false

# Log level: fatal|error|warn|info|debug|trace
LOG_LEVEL=info
